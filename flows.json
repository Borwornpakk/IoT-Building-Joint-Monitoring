    {
        "id": "a0729b22b87179d1",
        "type": "function",
        "z": "6835bfa401e18e9c",
        "name": "Safety Analysis (DOWSIL 795)",
        "func": "// กำหนดค่ามาตรฐานร่องเดิม (Initial Joint Width) เช่น 10 มม.\nvar initialWidth = 10.0;\n\n// ค่าระยะยืดตัวสูงสุดที่ยอมรับได้ (Elongation at 400%)\nvar maxSafeElongation = 40.0;\n\n// รับค่าระยะขยับตัวปัจจุบันจากเซนเซอร์จำลอง\nvar currentMovement = msg.payload.joint_mm;\n\n// คำนวณสถานะความปลอดภัย\nif (currentMovement >= maxSafeElongation) {\n    msg.payload = \"CRITICAL: Movement exceeds 400% limit (\" + currentMovement + \" mm). Structural risk detected!\";\n    msg.status = \"danger\";\n} else if (currentMovement >= (maxSafeElongation * 0.8)) {\n    msg.payload = \"WARNING: Movement approaching 400% limit. Inspect sealant integrity.\";\n    msg.status = \"warning\";\n} else {\n    msg.payload = \"NORMAL: System within safe operational limits.\";\n    msg.status = \"success\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
