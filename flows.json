    {
        "id": "4850c0fce1b375a4",
        "type": "function",
        "z": "6835bfa401e18e9c",
        "name": "Random Joint & Temp Data",
        "func": "// สุ่มค่า Joint Movement ระหว่าง 2.0 ถึง 6.0 มม.\nvar jointMovement = parseFloat((Math.random() * (6.0 - 2.0) + 2.0).toFixed(2));\n\n// สุ่มค่าอุณหภูมิผิววัสดุระหว่าง 30 ถึง 55 องศาเซลเซียส\nvar temperature = parseFloat((Math.random() * (55 - 30) + 30).toFixed(1));\n\n// แยกส่งข้อมูลเป็น 2 เส้นพร้อมระบุกลุ่มข้อมูล (Topic) เพื่อให้กราฟจำแนกเส้นได้\nvar msg1 = { payload: jointMovement, topic: \"Joint Displacement (mm)\" };\nvar msg2 = { payload: temperature, topic: \"Substrate Temp (°C)\" };\n\n// ส่งข้อมูลออกพร้อมกันทั้ง 2 ค่า\nreturn [msg1, msg2];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
