    {
        "id": "25a6a934fb28e3ee",
        "type": "function",
        "z": "bf0b092fe846c588",
        "name": "Generate Random Sensor Data",
        "func": "// DOWSIL 795 — ใช้ร่องมาตรฐาน 10mm\nconst JOINT_WIDTH_MM = 10;   // ความกว้างร่องเริ่มต้น\nconst ELONG_400_MM = 40;   // ยืดได้สูงสุดที่ 400% = 40mm\nconst ELONG_600_MM = 60;   // ยืดได้สูงสุดที่ 600% = 60mm\nconst ALARM_MM = 40;   // Alarm ที่ 400% = 40mm\nconst WARN_MM = 24;   // Warning ที่ 240% = 24mm (60% ของ limit)\n\nconst sensors = [\n  { id: 'SNS-F01-N', zone: 'North', floor: 1 },\n  { id: 'SNS-F03-E', zone: 'East', floor: 3 },\n  { id: 'SNS-F05-S', zone: 'South', floor: 5 },\n  { id: 'SNS-F07-W', zone: 'West', floor: 7 },\n];\n\nfunction rnd(min, max) {\n  return parseFloat((Math.random() * (max - min) + min).toFixed(2));\n}\n\nconst now = new Date();\nconst hourAngle = (now.getHours() + now.getMinutes() / 60) / 24 * 2 * Math.PI;\nconst baseTempC = 28 + 12 * Math.sin(hourAngle - Math.PI / 2);\n\nconst readings = sensors.map(s => {\n  const tempC = rnd(Math.max(15, baseTempC - 5), Math.min(50, baseTempC + 5));\n  const tempFactor = (tempC - 15) / 35;\n  // displacement สัมพันธ์กับอุณหภูมิ — ช่วง 0 ถึง 45mm\n  const dispMm = rnd(\n    Math.max(0.5, 20 * tempFactor - 5),\n    Math.min(45, 20 * tempFactor + 8)\n  );\n  const elongPct = parseFloat(((dispMm / JOINT_WIDTH_MM) * 100).toFixed(1));\n\n  let alarmLevel = 'OK';\n  if (dispMm >= ALARM_MM) alarmLevel = 'ALARM';\n  else if (dispMm >= WARN_MM) alarmLevel = 'WARNING';\n\n  return {\n    sensorId: s.id,\n    zone: s.zone,\n    floor: s.floor,\n    timestamp: now.toISOString(),\n    temperature: tempC,\n    displacement: dispMm,\n    elongation: elongPct,\n    alarmLevel: alarmLevel,\n    alarmFlag: alarmLevel === 'ALARM',\n    jointWidthMm: JOINT_WIDTH_MM,\n    alarmMm: ALARM_MM,\n    warnMm: WARN_MM,\n    elong400mm: ELONG_400_MM,\n    elong600mm: ELONG_600_MM\n  };\n});\n\nconst primary = readings[0];\nmsg.payload = primary;\nmsg.readings = readings;\nmsg.topic = 'facade/joint/data';\nreturn msg;",
