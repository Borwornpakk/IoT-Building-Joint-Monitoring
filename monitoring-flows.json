    {
        "id": "3f3263eb6e0f93c7",
        "type": "function",
        "z": "bf0b092fe846c588",
        "name": "Alarm Logic (DOWSIL 795 Limits)",
        "func": "const data = msg.payload;\nif (!data || data.displacement === undefined) return null;\n\n// ค่าจาก TDS จริง\n// Design limit: ±50% × 10mm = 5mm (ASTM C719 Class 50)\n// Ultimate elongation: 400% × 10mm = 40mm (ASTM C1135)\nconst ALARM_MM        = data.alarmMm        || 5.0;   // เกิน design limit\nconst WARN_MM         = data.warnMm         || 4.0;   // 80% of design limit\nconst ULTIMATE_MM     = data.ultimateElongMm || 40.0; // absolute material limit\nconst DESIGN_MOVE_MM  = data.designMoveMm   || 5.0;\n\nconst disp  = data.displacement;\nconst elong = data.elongation;\nconst designUsedPct = data.designUsedPct || \n                      parseFloat(((disp / DESIGN_MOVE_MM) * 100).toFixed(1));\n\nlet level   = 'OK';\nlet message = '';\n\nif (disp >= ULTIMATE_MM) {\n    // เกิน ultimate elongation — อันตรายสูงสุด\n    level   = 'CRITICAL';\n    message = '🔴 CRITICAL FAILURE RISK — Sensor ' + data.sensorId +\n              ' (Zone ' + data.zone + ', Floor ' + data.floor + 'F)\\n' +\n              'Displacement: ' + disp.toFixed(2) + 'mm' +\n              ' | Elongation: ' + elong + '%\\n' +\n              'เกิน Ultimate Elongation 400% (' + ULTIMATE_MM + 'mm)\\n' +\n              'ตาม ASTM C1135 — ความเสี่ยงสูงสุด ต้องเปลี่ยน sealant ทันที!';\n\n} else if (disp >= ALARM_MM) {\n    // เกิน design movement limit ±50%\n    level   = 'ALARM';\n    message = '🚨 ALARM — Sensor ' + data.sensorId +\n              ' (Zone ' + data.zone + ', Floor ' + data.floor + 'F)\\n' +\n              'Displacement: ' + disp.toFixed(2) + 'mm' +\n              ' (' + designUsedPct + '% of design limit)\\n' +\n              'เกินขีดจำกัดออกแบบ ±50% = ' + ALARM_MM + 'mm\\n' +\n              'ตาม ASTM C719 Class 50 — ต้องตรวจสอบและประเมินทันที!';\n\n} else if (disp >= WARN_MM) {\n    // 80% ของ design limit\n    level   = 'WARNING';\n    message = '⚠️ WARNING — Sensor ' + data.sensorId +\n              ' (Zone ' + data.zone + ', Floor ' + data.floor + 'F)\\n' +\n              'Displacement: ' + disp.toFixed(2) + 'mm' +\n              ' (' + designUsedPct + '% of design limit)\\n' +\n              'เข้าสู่โซนเฝ้าระวัง (>80% of ±50% design limit)\\n' +\n              'กำหนดการตรวจสอบเพิ่มเติม';\n}\n\nif (level !== 'OK') {\n    msg.payload = {\n        level:    level,\n        message:  message,\n        sensor:   data.sensorId,\n        zone:     data.zone,\n        floor:    data.floor,\n        timestamp: data.timestamp,\n        values: {\n            displacement:   disp,\n            elongation:     elong,\n            designUsedPct:  designUsedPct,\n            temperature:    data.temperature,\n            designMoveMm:   DESIGN_MOVE_MM,\n            alarmMm:        ALARM_MM,\n            ultimateMm:     ULTIMATE_MM\n        }\n    };\n    msg.topic = 'facade/joint/alarm';\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
