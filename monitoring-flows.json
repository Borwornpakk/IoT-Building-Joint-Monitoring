    {
        "id": "888192268d43f10b",
        "type": "ui_template",
        "z": "bf0b092fe846c588",
        "group": "ui-group-chart",
        "name": "",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<style>\n    .fio-wrap {\n        font-family: sans-serif;\n        background: #fff;\n        padding: 14px;\n        border-radius: 8px;\n    }\n\n    .metric-row {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 10px;\n        margin-bottom: 14px;\n    }\n\n    .metric-card {\n        background: #f9fafb;\n        border-radius: 8px;\n        padding: 10px 14px;\n    }\n\n    .m-label {\n        font-size: 11px;\n        color: #6b7280;\n        margin-bottom: 4px;\n    }\n\n    .m-value {\n        font-size: 22px;\n        font-weight: 500;\n        color: #111;\n    }\n\n    .m-unit {\n        font-size: 11px;\n        color: #6b7280;\n    }\n\n    .badge {\n        margin-top: 5px;\n        font-size: 11px;\n        padding: 2px 8px;\n        border-radius: 4px;\n        display: inline-block;\n        font-weight: 500;\n    }\n\n    .ok {\n        background: #dcfce7;\n        color: #16a34a;\n    }\n\n    .warn {\n        background: #fef9c3;\n        color: #ca8a04;\n    }\n\n    .danger {\n        background: #fee2e2;\n        color: #dc2626;\n    }\n\n    .chart-hdr {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        margin-bottom: 6px;\n        flex-wrap: wrap;\n        gap: 6px;\n    }\n\n    .chart-title {\n        font-size: 13px;\n        font-weight: 500;\n        color: #111;\n    }\n\n    .legend {\n        display: flex;\n        gap: 14px;\n        flex-wrap: wrap;\n    }\n\n    .leg-item {\n        display: flex;\n        align-items: center;\n        gap: 5px;\n        font-size: 11px;\n        color: #555;\n    }\n\n    .leg-line {\n        width: 18px;\n        height: 3px;\n        border-radius: 2px;\n    }\n\n    .status-bar {\n        font-size: 12px;\n        margin-bottom: 8px;\n        display: flex;\n        align-items: center;\n        gap: 6px;\n    }\n\n    .live-dot {\n        width: 8px;\n        height: 8px;\n        border-radius: 50%;\n        background: #d1d5db;\n        flex-shrink: 0;\n    }\n\n    .tbl-wrap {\n        margin-top: 16px;\n    }\n\n    .tbl-label {\n        font-size: 11px;\n        font-weight: 600;\n        letter-spacing: .08em;\n        color: #6b7280;\n        margin-bottom: 8px;\n    }\n\n    .sns-tbl {\n        width: 100%;\n        border-collapse: collapse;\n        font-size: 13px;\n    }\n\n    .sns-tbl th {\n        text-align: left;\n        padding: 5px 8px;\n        color: #374151;\n        font-weight: 500;\n        border-bottom: 1.5px solid #e5e7eb;\n    }\n\n    .sns-tbl td {\n        padding: 6px 8px;\n        border-bottom: 1px solid #f3f4f6;\n    }\n\n    .ctrl-bar {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        flex-wrap: wrap;\n        padding: 8px 12px;\n        background: #f3f4f6;\n        border-radius: 8px;\n        margin-top: 14px;\n    }\n\n    .ctrl-lbl {\n        font-size: 12px;\n        color: #374151;\n    }\n\n    .ctrl-btn {\n        font-size: 12px;\n        padding: 4px 14px;\n        border: 1px solid #d1d5db;\n        border-radius: 6px;\n        cursor: pointer;\n    }\n\n    .btn-active {\n        background: #111;\n        color: #fff;\n    }\n\n    .btn-idle {\n        background: #fff;\n        color: #111;\n    }\n</style>\n\n<div class=\"fio-wrap\">\n\n    <!-- ① Metric Cards -->\n    <div class=\"metric-row\">\n        <div class=\"metric-card\">\n            <div class=\"m-label\">🌡 Temperature</div>\n            <div><span class=\"m-value\" id=\"mTemp\">—</span><span class=\"m-unit\"> °C</span></div>\n            <div class=\"badge ok\" id=\"bTemp\">Normal</div>\n        </div>\n        <div class=\"metric-card\">\n            <div class=\"m-label\">↔ Displacement</div>\n            <div><span class=\"m-value\" id=\"mDisp\">—</span><span class=\"m-unit\"> mm</span></div>\n            <div class=\"badge ok\" id=\"bDisp\">Within Limit</div>\n        </div>\n        <div class=\"metric-card\">\n            <div class=\"m-label\">% Elongation Used</div>\n            <div><span class=\"m-value\" id=\"mElong\">—</span><span class=\"m-unit\"> %</span></div>\n            <div class=\"badge ok\" id=\"bElong\">Safe</div>\n        </div>\n        <div class=\"metric-card\">\n            <div class=\"m-label\">⚠ Alert Count</div>\n            <div><span class=\"m-value\" id=\"mAlert\">0</span><span class=\"m-unit\"> events</span></div>\n            <div class=\"badge ok\" id=\"bAlert\">No Alarm</div>\n        </div>\n    </div>\n\n    <!-- ② Chart -->\n    <div class=\"chart-hdr\">\n        <span class=\"chart-title\">Real-time: Temperature vs. Joint Displacement (Dual-Axis)</span>\n        <div class=\"legend\">\n            <span class=\"leg-item\"><span class=\"leg-line\" style=\"background:#ef4444\"></span>Temp (°C) — left</span>\n            <span class=\"leg-item\"><span class=\"leg-line\" style=\"background:#3b82f6\"></span>Displacement (mm) —\n            right</span>\n            <span class=\"leg-item\"><span class=\"leg-line\" style=\"background:#ef4444;border-top:2px dashed #ef4444;height:0\"></span>Alarm\n            limit</span>\n        </div>\n    </div>\n    <div class=\"status-bar\">\n        <span class=\"live-dot\" id=\"liveDot\"></span>\n        <span id=\"liveText\" style=\"color:#6b7280;\">Connecting...</span>\n    </div>\n    <div style=\"position:relative;width:100%;height:300px;\">\n        <canvas id=\"dualChart\"></canvas>\n    </div>\n\n    <!-- ③ Sensor Table -->\n    <div class=\"tbl-wrap\">\n        <div class=\"tbl-label\">SENSOR NETWORK STATUS</div>\n        <table class=\"sns-tbl\">\n            <thead>\n                <tr>\n                    <th>Sensor ID</th>\n                    <th>Zone</th>\n                    <th>Floor</th>\n                    <th>Temp (°C)</th>\n                    <th>Displacement (mm)</th>\n                    <th>Elongation</th>\n                    <th>Status</th>\n                </tr>\n            </thead>\n            <tbody id=\"snsTbody\">\n                <tr>\n                    <td colspan=\"7\" style=\"padding:14px;color:#9ca3af;text-align:center;\">Waiting for data...</td>\n                </tr>\n            </tbody>\n        </table>\n        <div id=\"tblTs\" style=\"font-size:11px;color:#9ca3af;margin-top:4px;text-align:right;\"></div>\n    </div>\n\n    <!-- ④ Control Bar -->\n    <div class=\"ctrl-bar\">\n        <span class=\"ctrl-lbl\">▷ Simulation</span>\n        <button id=\"btnStop\" class=\"ctrl-btn btn-active\" onclick=\"toggleSim()\">Stop</button>\n        <button class=\"ctrl-btn btn-idle\" onclick=\"doClear()\">Clear</button>\n        <span class=\"ctrl-lbl\" style=\"margin-left:6px;\">Interval:</span>\n        <button id=\"iv2\"  class=\"ctrl-btn btn-active\" onclick=\"setIv(2000,'iv2')\">2s</button>\n        <button id=\"iv5\"  class=\"ctrl-btn btn-idle\"   onclick=\"setIv(5000,'iv5')\">5s</button>\n        <button id=\"iv10\" class=\"ctrl-btn btn-idle\"   onclick=\"setIv(10000,'iv10')\">10s</button>\n        <span class=\"ctrl-lbl\" style=\"margin-left:6px;\">\n      Topic: <code style=\"background:#e5e7eb;padding:1px 6px;border-radius:4px;font-size:11px;\">facade/joint/data</code>\n    </span>\n    </div>\n\n</div>\n\n<script>\n    (function() {\n  /* ---- constants ---- */\n  var MAX     = 50;\n  var JW      = 10;\n  var ALARM_D = 40;\n  var WARN_D  = 24;\n\n  /* ---- state ---- */\n  var chart      = null;\n  var ws         = null;\n  var running    = true;\n  var currentIv  = 2000;\n  var alertTotal = 0;\n  var simTimer   = null;\n\n  /* ---- badge ---- */\n  function setBadge(id, text, cls) {\n    var el = document.getElementById(id);\n    if (!el) return;\n    el.textContent = text;\n    el.className   = 'badge ' + cls;\n  }\n\n  /* ---- update metric cards ---- */\n  function updateMetrics(d) {\n    var mT = document.getElementById('mTemp');\n    var mD = document.getElementById('mDisp');\n    var mE = document.getElementById('mElong');\n    var mA = document.getElementById('mAlert');\n    if (mT) mT.textContent = parseFloat(d.temperature).toFixed(1);\n    if (mD) mD.textContent = parseFloat(d.displacement).toFixed(2);\n    if (mE) mE.textContent = parseFloat(d.elongation).toFixed(1);\n\n    setBadge('bTemp', parseFloat(d.temperature).toFixed(1) + ' °C', 'ok');\n\n    var disp = parseFloat(d.displacement);\n    if (disp >= ALARM_D) {\n      alertTotal++;\n      setBadge('bDisp',  'ALARM',    'danger');\n      setBadge('bElong', 'CRITICAL', 'danger');\n      setBadge('bAlert', 'ALARM',    'danger');\n    } else if (disp >= WARN_D) {\n      setBadge('bDisp',  'WARNING',  'warn');\n      setBadge('bElong', 'Caution',  'warn');\n      setBadge('bAlert', alertTotal > 0 ? alertTotal + ' events' : 'No Alarm',\n               alertTotal > 0 ? 'warn' : 'ok');\n    } else {\n      setBadge('bDisp',  'Within Limit', 'ok');\n      setBadge('bElong', parseFloat(d.elongation).toFixed(1) + '%', 'ok');\n      setBadge('bAlert', alertTotal > 0 ? alertTotal + ' events' : 'No Alarm',\n               alertTotal > 0 ? 'warn' : 'ok');\n    }\n    if (mA) mA.textContent = alertTotal;\n  }\n\n  /* ---- status bar ---- */\n  function updateStatus(d) {\n    var dot  = document.getElementById('liveDot');\n    var text = document.getElementById('liveText');\n    if (!dot || !text) return;\n    var disp = parseFloat(d.displacement);\n    if (disp >= ALARM_D) {\n      dot.style.background = '#ef4444'; text.style.color = '#ef4444';\n      text.textContent = '🚨 ALARM — Displacement ' + disp.toFixed(2) +\n                         'mm (Elongation ' + d.elongation + '%) เกินขีดจำกัด 400%!';\n    } else if (disp >= WARN_D) {\n      dot.style.background = '#f59e0b'; text.style.color = '#f59e0b';\n      text.textContent = '⚠ WARNING — Displacement ' + disp.toFixed(2) +\n                         'mm (Elongation ' + d.elongation + '%)';\n    } else {\n      dot.style.background = '#22c55e'; text.style.color = '#22c55e';\n      text.textContent = '● Live  |  Temp: ' + parseFloat(d.temperature).toFixed(1) +\n                         '°C  |  Disp: ' + parseFloat(d.displacement).toFixed(2) +\n                         'mm  |  Elong: ' + d.elongation + '%';\n    }\n  }\n\n  /* ---- push chart point ---- */\n  function pushChart(d) {\n    if (!chart || !d) return;\n    chart.data.labels.push(d.label);\n    chart.data.datasets[0].data.push(parseFloat(d.temperature));\n    chart.data.datasets[1].data.push(parseFloat(d.displacement));\n    if (chart.data.labels.length > MAX) {\n      chart.data.labels.shift();\n      chart.data.datasets[0].data.shift();\n      chart.data.datasets[1].data.shift();\n    }\n    chart.data.datasets[2].data = chart.data.labels.map(function(){ return ALARM_D; });\n    chart.data.datasets[3].data = chart.data.labels.map(function(){ return WARN_D;  });\n    chart.update();\n  }\n\n  /* ---- render table ---- */\n  function renderTable(rows) {\n    var tbody = document.getElementById('snsTbody');\n    if (!tbody || !rows || !rows.length) return;\n    function dc(v){ return v>=ALARM_D?'#ef4444':v>=WARN_D?'#f59e0b':'#111'; }\n    function st(v){\n      if(v>=ALARM_D) return '<span style=\"color:#ef4444;font-weight:500;\">● ALARM</span>';\n      if(v>=WARN_D)  return '<span style=\"color:#f59e0b;font-weight:500;\">● Caution</span>';\n      return '<span style=\"color:#22c55e;\">● OK</span>';\n    }\n    tbody.innerHTML = rows.map(function(r,i){\n      var d = parseFloat(r.displacement);\n      return '<tr style=\"background:'+(i%2?'#f9fafb':'#fff')+';border-bottom:1px solid #f3f4f6;\">'+\n        '<td style=\"padding:6px 8px;font-family:monospace;font-size:12px;\">'+r.sensorId+'</td>'+\n        '<td style=\"padding:6px 8px;\">'+r.zone+'</td>'+\n        '<td style=\"padding:6px 8px;\">'+r.floor+'F</td>'+\n        '<td style=\"padding:6px 8px;\">'+parseFloat(r.temperature).toFixed(1)+'</td>'+\n        '<td style=\"padding:6px 8px;color:'+dc(d)+';font-weight:500;\">'+d.toFixed(2)+'</td>'+\n        '<td style=\"padding:6px 8px;color:'+dc(d)+';\">'+r.elongation+'%</td>'+\n        '<td style=\"padding:6px 8px;\">'+st(d)+'</td>'+\n      '</tr>';\n    }).join('');\n    var ts = document.getElementById('tblTs');\n    if (ts) ts.textContent = 'Updated: ' + new Date().toLocaleTimeString('th-TH');\n  }\n\n  /* ---- build chart ---- */\n  function buildChart() {\n    if (chart) return;\n    var c = document.getElementById('dualChart');\n    if (!c) return;\n    chart = new Chart(c.getContext('2d'), {\n      type: 'line',\n      data: {\n        labels: [],\n        datasets: [\n          { label:'Temperature (°C)', data:[], yAxisID:'yL',\n            borderColor:'#ef4444', backgroundColor:'rgba(0,0,0,0)',\n            borderWidth:2, pointRadius:3, fill:false, lineTension:0.4 },\n          { label:'Displacement (mm)', data:[], yAxisID:'yR',\n            borderColor:'#3b82f6', backgroundColor:'rgba(0,0,0,0)',\n            borderWidth:2, pointRadius:3, fill:false, lineTension:0.4 },\n          { label:'Alarm 400% (40mm)', data:[], yAxisID:'yR',\n            borderColor:'#ef4444', borderWidth:1.5, borderDash:[6,4],\n            pointRadius:0, fill:false },\n          { label:'Warning 240% (24mm)', data:[], yAxisID:'yR',\n            borderColor:'#f59e0b', borderWidth:1.5, borderDash:[4,4],\n            pointRadius:0, fill:false }\n        ]\n      },\n      options: {\n        responsive:true, maintainAspectRatio:false,\n        animation:{ duration:150 },\n        legend:{ position:'top', labels:{ fontSize:11 } },\n        tooltips:{ mode:'index', intersect:false },\n        scales:{\n          xAxes:[{ ticks:{ maxTicksLimit:8, maxRotation:0, fontSize:10 } }],\n          yAxes:[\n            { id:'yL', position:'left',\n              scaleLabel:{ display:true, labelString:'Temperature (°C)', fontColor:'#ef4444', fontSize:11 },\n              ticks:{ min:10, max:55, fontColor:'#ef4444', fontSize:10 } },\n            { id:'yR', position:'right',\n              gridLines:{ drawOnChartArea:false },\n              scaleLabel:{ display:true, labelString:'Displacement (mm)', fontColor:'#3b82f6', fontSize:11 },\n              ticks:{ min:0, max:50, fontColor:'#3b82f6', fontSize:10,\n                callback:function(v){ return v+'mm ('+((v/JW)*100).toFixed(0)+'%)'; } } }\n          ]\n        }\n      }\n    });\n  }\n\n  /* ---- controls ---- */\n  window.toggleSim = function() {\n    running = !running;\n    var btn = document.getElementById('btnStop');\n    if (btn) {\n      btn.textContent = running ? 'Stop' : 'Start';\n      btn.className   = 'ctrl-btn ' + (running ? 'btn-active' : 'btn-idle');\n    }\n    if (running) startSim(); else { if(simTimer) clearInterval(simTimer); }\n  };\n\n  window.doClear = function() {\n    alertTotal = 0;\n    ['mTemp','mDisp','mElong'].forEach(function(id){\n      var el=document.getElementById(id); if(el) el.textContent='—';\n    });\n    var mA=document.getElementById('mAlert'); if(mA) mA.textContent='0';\n    setBadge('bTemp','Normal','ok');\n    setBadge('bDisp','Within Limit','ok');\n    setBadge('bElong','Safe','ok');\n    setBadge('bAlert','No Alarm','ok');\n    if (chart) {\n      chart.data.labels=[];\n      chart.data.datasets.forEach(function(d){ d.data=[]; });\n      chart.update();\n    }\n  };\n\n  window.setIv = function(ms, id) {\n    currentIv = ms;\n    ['iv2','iv5','iv10'].forEach(function(bid){\n      var b=document.getElementById(bid);\n      if(b) b.className='ctrl-btn btn-idle';\n    });\n    var active=document.getElementById(id);\n    if(active) active.className='ctrl-btn btn-active';\n    if(running) startSim();\n  };\n\n  function startSim() {\n    if (simTimer) clearInterval(simTimer);\n    simTimer = setInterval(function(){\n      // inject ผ่าน Node-RED WebSocket Input node\n      if (ws && ws.readyState === 1) ws.send('inject');\n    }, currentIv);\n  }\n\n  /* ---- WebSocket ---- */\n  function connectWS() {\n    var host = window.location.hostname;\n    var port = window.location.port || 1880;\n    ws = new WebSocket('ws://' + host + ':' + port + '/ws/chart');\n\n    ws.onopen = function() {\n      var dot=document.getElementById('liveDot');\n      var txt=document.getElementById('liveText');\n      if(dot) dot.style.background='#f59e0b';\n      if(txt){ txt.style.color='#f59e0b'; txt.textContent='Connected — waiting for data...'; }\n      if(running) startSim();\n    };\n\n    ws.onmessage = function(e) {\n      try {\n        var pkt = JSON.parse(e.data);\n        if (pkt.type === 'update') {\n          if (pkt.chart)   { pushChart(pkt.chart); updateStatus(pkt.chart); updateMetrics(pkt.chart); }\n          if (pkt.table)   { renderTable(pkt.table); }\n        }\n      } catch(err) {}\n    };\n\n    ws.onclose = function() {\n      var txt=document.getElementById('liveText');\n      if(txt) txt.textContent='Reconnecting...';\n      setTimeout(connectWS, 3000);\n    };\n  }\n\n  /* ---- init ---- */\n  setTimeout(function(){ buildChart(); connectWS(); }, 500);\n})();\n</script>",
