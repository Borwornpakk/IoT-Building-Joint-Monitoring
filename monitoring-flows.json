    {
        "id": "25a6a934fb28e3ee",
        "type": "function",
        "z": "bf0b092fe846c588",
        "name": "Generate Random Sensor Data",
        "func": "// ============================================\n// DOWSIL 795 — ค่าจาก TDS จริง (Form No. 63-1217-01-0124)\n// ============================================\n// Joint movement capability: ±50% (ASTM C719 Class 50)\n// Ultimate elongation at break: 400% (ASTM C1135, 21 days)\n// Ultimate elongation (7 days): 670% (ASTM D412)\n// Tensile strength at 100% elong: 0.6 MPa\n// Minimum structural bite: 6mm\n// Maximum bite (one side cure): 12mm\n// Glueline thickness minimum: 6mm\n// Bite:glueline ratio max: 3:1\n\nconst JOINT_WIDTH_MM  = 10;    // ความกว้างร่องออกแบบ (mm)\nconst GLUELINE_MM     = 6;     // ความหนา glueline (mm) — TDS minimum\n\n// Design movement limit: ±50% ตาม ASTM C719\nconst DESIGN_MOVE_PCT = 50;                              // %\nconst DESIGN_MOVE_MM  = JOINT_WIDTH_MM * DESIGN_MOVE_PCT / 100;  // 5mm\n\n// Ultimate elongation: 400% (21-day cure, ASTM C1135)\nconst ULTIMATE_ELONG_PCT = 400;\nconst ULTIMATE_ELONG_MM  = JOINT_WIDTH_MM * ULTIMATE_ELONG_PCT / 100; // 40mm\n\n// Alarm thresholds\nconst ALARM_MM = DESIGN_MOVE_MM;           // >5mm = เกิน design limit\nconst WARN_MM  = DESIGN_MOVE_MM * 0.80;   // >4mm = 80% of design limit\n\nconst sensors = [\n  { id: 'SNS-F01-N', zone: 'North', floor: 1 },\n  { id: 'SNS-F03-E', zone: 'East',  floor: 3 },\n  { id: 'SNS-F05-S', zone: 'South', floor: 5 },\n  { id: 'SNS-F07-W', zone: 'West',  floor: 7 },\n];\n\nfunction rnd(min, max) {\n    return parseFloat((Math.random() * (max - min) + min).toFixed(2));\n}\n\nconst now = new Date();\nconst hourAngle = (now.getHours() + now.getMinutes()/60) / 24 * 2 * Math.PI;\nconst baseTempC  = 28 + 12 * Math.sin(hourAngle - Math.PI/2);\n\nconst readings = sensors.map(s => {\n    const tempC      = rnd(Math.max(15, baseTempC - 5), Math.min(50, baseTempC + 5));\n    const tempFactor = (tempC - 15) / 35;\n\n    // displacement จำลองตาม thermal movement จริง\n    // ±50% ของ 10mm = ±5mm → range = 0 ถึง 8mm (รวม safety margin)\n    const dispMm = rnd(\n        Math.max(0.1, DESIGN_MOVE_MM * tempFactor * 0.5),\n        Math.min(DESIGN_MOVE_MM * 1.5, DESIGN_MOVE_MM * tempFactor * 1.2 + 1)\n    );\n\n    // Elongation = displacement / joint_width × 100\n    const elongPct = parseFloat(((dispMm / JOINT_WIDTH_MM) * 100).toFixed(1));\n\n    // % ของ design limit ที่ใช้ไป\n    const designUsedPct = parseFloat(((dispMm / DESIGN_MOVE_MM) * 100).toFixed(1));\n\n    let alarmLevel = 'OK';\n    if      (dispMm >= ALARM_MM) alarmLevel = 'ALARM';\n    else if (dispMm >= WARN_MM)  alarmLevel = 'WARNING';\n\n    return {\n        sensorId:       s.id,\n        zone:           s.zone,\n        floor:          s.floor,\n        timestamp:      now.toISOString(),\n        temperature:    tempC,\n        displacement:   dispMm,\n        elongation:     elongPct,\n        designUsedPct:  designUsedPct,   // % ของ ±50% design limit\n        alarmLevel:     alarmLevel,\n        alarmFlag:      alarmLevel === 'ALARM',\n        // TDS reference values\n        jointWidthMm:   JOINT_WIDTH_MM,\n        gluelineMm:     GLUELINE_MM,\n        designMoveMm:   DESIGN_MOVE_MM,   // 5mm (±50%)\n        alarmMm:        ALARM_MM,         // 5mm\n        warnMm:         WARN_MM,          // 4mm\n        ultimateElongPct: ULTIMATE_ELONG_PCT,  // 400%\n        ultimateElongMm:  ULTIMATE_ELONG_MM    // 40mm\n    };\n});\n\nconst primary    = readings[0];\nmsg.payload      = primary;\nmsg.readings     = readings;\nmsg.topic        = 'facade/joint/data';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
