    {
        "id": "7f776bfcdd08379a",
        "type": "function",
        "z": "bf0b092fe846c588",
        "name": "Prepare Dual-Axis Chart Data",
        "func": "const data = msg.payload;\nif (!data || data.temperature === undefined) return null;\n\nconst ALARM_MM = 40;   // 400% × 10mm\nconst WARN_MM = 24;   // 240% × 10mm\n\nconst ts = new Date(data.timestamp || Date.now());\nconst hh = ts.getHours().toString().padStart(2, '0');\nconst mm2 = ts.getMinutes().toString().padStart(2, '0');\nconst ss = ts.getSeconds().toString().padStart(2, '0');\n\nconst disp = data.displacement;\nconst elong = data.elongation;\n\nlet alertCount = context.get('alertCount') || 0;\nif (disp >= ALARM_MM) {\n    alertCount++;\n    context.set('alertCount', alertCount);\n}\n\nlet dispBadge = 'Within Limit';\nlet elongBadge = 'Safe';\nlet alertBadge = 'No Alarm';\n\nif (disp >= ALARM_MM) {\n    dispBadge = 'ALARM';\n    elongBadge = 'CRITICAL';\n    alertBadge = 'ALARM';\n} else if (disp >= WARN_MM) {\n    dispBadge = 'WARNING';\n    elongBadge = 'Caution';\n    alertBadge = alertCount > 0 ? alertCount + ' events' : 'No Alarm';\n}\n\nmsg.payload = JSON.stringify({\n    type: 'update',\n    chart: {\n        label: hh + ':' + mm2 + ':' + ss,\n        temperature: data.temperature,\n        displacement: disp,\n        elongation: elong,\n        alarmFlag: disp >= ALARM_MM,\n        warnFlag: disp >= WARN_MM\n    },\n    table: msg.readings || [],\n    metrics: {\n        temperature: data.temperature,\n        displacement: disp,\n        elongation: elong,\n        alertCount: alertCount,\n        dispBadge: dispBadge,\n        elongBadge: elongBadge,\n        alertBadge: alertBadge,\n        alarmMm: ALARM_MM,\n        warnMm: WARN_MM\n    }\n});\nmsg.topic = 'chartPoint';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1090,
        "y": 460,
        "wires": [
            [
                "7fcccc7caee5fa58",
                "9a442fe4d1ad3cf7"
            ]
        ]
    },
    {
        "id": "9a442fe4d1ad3cf7",
        "type": "ui_template",
        "z": "bf0b092fe846c588",
        "group": "ui-group-chart",
        "name": "Dual-Axis Chart (Temperature & Displacement)",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div style=\"background:#fff;border-radius:8px;padding:12px 14px;font-family:sans-serif;\">\n\n  <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px;\">\n    <span id=\"liveDot\" style=\"width:8px;height:8px;border-radius:50%;\n          background:#d1d5db;display:inline-block;flex-shrink:0;\"></span>\n    <span id=\"liveText\" style=\"font-size:12px;color:#6b7280;\">Connecting...</span>\n  </div>\n\n  <div style=\"position:relative;width:100%;height:320px;\">\n    <canvas id=\"dualChart\"></canvas>\n  </div>\n\n  <!-- Sensor Table -->\n  <div style=\"margin-top:18px;\">\n    <div style=\"font-size:11px;font-weight:600;letter-spacing:.08em;\n                color:#6b7280;margin-bottom:8px;\">SENSOR NETWORK STATUS</div>\n    <table style=\"width:100%;border-collapse:collapse;font-size:13px;\">\n      <thead>\n        <tr style=\"border-bottom:1.5px solid #e5e7eb;\">\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Sensor ID</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Zone</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Floor</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Temp (°C)</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Displacement (mm)</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Elongation</th>\n          <th style=\"text-align:left;padding:5px 8px;color:#374151;font-weight:500;\">Status</th>\n        </tr>\n      </thead>\n      <tbody id=\"sensorTbody\">\n        <tr><td colspan=\"7\" style=\"padding:14px;color:#9ca3af;text-align:center;\">\n          Waiting for data...\n        </td></tr>\n      </tbody>\n    </table>\n    <div id=\"tblTs\" style=\"font-size:11px;color:#9ca3af;margin-top:5px;text-align:right;\"></div>\n  </div>\n</div>\n\n<script>\n(function() {\n  var MAX     = 50;\n  var JW      = 10;      // joint width 10mm\n  var ALARM_D = 40;      // 400% × 10mm\n  var WARN_D  = 24;      // 240% × 10mm\n  var chart   = null;\n  var ws      = null;\n\n  /* ---- build Chart.js 2.x ---- */\n  function buildChart() {\n    if (chart) return;\n    var canvas = document.getElementById('dualChart');\n    if (!canvas) return;\n    chart = new Chart(canvas.getContext('2d'), {\n      type: 'line',\n      data: {\n        labels: [],\n        datasets: [\n          {\n            label: 'Temperature (°C)',\n            data: [], yAxisID: 'yL',\n            borderColor: '#ef4444',\n            backgroundColor: 'rgba(239,68,68,0.0)',\n            borderWidth: 2, pointRadius: 3,\n            fill: false, lineTension: 0.4\n          },\n          {\n            label: 'Displacement (mm)',\n            data: [], yAxisID: 'yR',\n            borderColor: '#3b82f6',\n            backgroundColor: 'rgba(59,130,246,0.0)',\n            borderWidth: 2, pointRadius: 3,\n            fill: false, lineTension: 0.4\n          },\n          {\n            label: 'Alarm 400% (' + ALARM_D + 'mm)',\n            data: [], yAxisID: 'yR',\n            borderColor: '#ef4444',\n            borderWidth: 1.5, borderDash: [6,4],\n            pointRadius: 0, fill: false\n          },\n          {\n            label: 'Warning 240% (' + WARN_D + 'mm)',\n            data: [], yAxisID: 'yR',\n            borderColor: '#f59e0b',\n            borderWidth: 1.5, borderDash: [4,4],\n            pointRadius: 0, fill: false\n          }\n        ]\n      },\n      options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        animation: { duration: 150 },\n        legend: { position: 'top', labels: { fontSize: 11 } },\n        tooltips: { mode: 'index', intersect: false },\n        scales: {\n          xAxes: [{ ticks: { maxTicksLimit: 8, maxRotation: 0, autoSkip: true, fontSize: 10 } }],\n          yAxes: [\n            {\n              id: 'yL', position: 'left',\n              scaleLabel: { display: true, labelString: 'Temperature (°C)', fontColor: '#ef4444', fontSize: 11 },\n              ticks: { min: 10, max: 55, fontColor: '#ef4444', fontSize: 10 }\n            },\n            {\n              id: 'yR', position: 'right',\n              gridLines: { drawOnChartArea: false },\n              scaleLabel: { display: true, labelString: 'Displacement (mm)', fontColor: '#3b82f6', fontSize: 11 },\n              ticks: {\n                min: 0, max: 50, fontColor: '#3b82f6', fontSize: 10,\n                callback: function(v) {\n                  return v + 'mm (' + ((v/JW)*100).toFixed(0) + '%)';\n                }\n              }\n            }\n          ]\n        }\n      }\n    });\n  }\n\n  /* ---- push chart point ---- */\n  function pushChart(d) {\n    if (!chart || !d) return;\n    chart.data.labels.push(d.label);\n    chart.data.datasets[0].data.push(d.temperature);\n    chart.data.datasets[1].data.push(d.displacement);\n    if (chart.data.labels.length > MAX) {\n      chart.data.labels.shift();\n      chart.data.datasets[0].data.shift();\n      chart.data.datasets[1].data.shift();\n    }\n    // reference lines\n    chart.data.datasets[2].data = chart.data.labels.map(function(){ return ALARM_D; });\n    chart.data.datasets[3].data = chart.data.labels.map(function(){ return WARN_D;  });\n    chart.update();\n  }\n\n  /* ---- update status bar ---- */\n  function updateStatus(d) {\n    var dot  = document.getElementById('liveDot');\n    var text = document.getElementById('liveText');\n    if (!dot || !text) return;\n    var disp = parseFloat(d.displacement);\n    if (disp >= ALARM_D) {\n      dot.style.background = '#ef4444';\n      text.style.color     = '#ef4444';\n      text.textContent     = '🚨 ALARM — Displacement ' + disp.toFixed(2) + 'mm (Elongation ' + d.elongation + '%) เกินขีดจำกัด 400%!';\n    } else if (disp >= WARN_D) {\n      dot.style.background = '#f59e0b';\n      text.style.color     = '#f59e0b';\n      text.textContent     = '⚠ WARNING — Displacement ' + disp.toFixed(2) + 'mm (Elongation ' + d.elongation + '%) เข้าโซนเฝ้าระวัง';\n    } else {\n      dot.style.background = '#22c55e';\n      text.style.color     = '#22c55e';\n      text.textContent     = '● Live  |  Temp: ' + d.temperature + '°C  |  Disp: ' + disp.toFixed(2) + 'mm  |  Elong: ' + d.elongation + '%';\n    }\n  }\n\n  /* ---- render sensor table ---- */\n  function renderTable(rows) {\n    var tbody = document.getElementById('sensorTbody');\n    if (!tbody || !rows || !rows.length) return;\n\n    function dispColor(disp) {\n      return disp >= ALARM_D ? '#ef4444' : disp >= WARN_D ? '#f59e0b' : '#111827';\n    }\n    function statusBadge(disp) {\n      if (disp >= ALARM_D) return '<span style=\"color:#ef4444;font-weight:500;\">● ALARM</span>';\n      if (disp >= WARN_D)  return '<span style=\"color:#f59e0b;font-weight:500;\">● Caution</span>';\n      return '<span style=\"color:#22c55e;\">● OK</span>';\n    }\n\n    tbody.innerHTML = rows.map(function(r, i) {\n      var disp = parseFloat(r.displacement);\n      var bg   = i % 2 === 0 ? '#fff' : '#f9fafb';\n      return '<tr style=\"background:' + bg + ';border-bottom:1px solid #f3f4f6;\">' +\n        '<td style=\"padding:6px 8px;font-family:monospace;font-size:12px;\">' + r.sensorId + '</td>' +\n        '<td style=\"padding:6px 8px;\">' + r.zone + '</td>' +\n        '<td style=\"padding:6px 8px;\">' + r.floor + 'F</td>' +\n        '<td style=\"padding:6px 8px;color:#111;\">' + parseFloat(r.temperature).toFixed(1) + '</td>' +\n        '<td style=\"padding:6px 8px;color:' + dispColor(disp) + ';font-weight:500;\">' + disp.toFixed(2) + '</td>' +\n        '<td style=\"padding:6px 8px;color:' + dispColor(disp) + ';\">' + r.elongation + '%</td>' +\n        '<td style=\"padding:6px 8px;\">' + statusBadge(disp) + '</td>' +\n      '</tr>';\n    }).join('');\n\n    var ts = document.getElementById('tblTs');\n    if (ts) ts.textContent = 'Updated: ' + new Date().toLocaleTimeString('th-TH');\n  }\n\n  /* ---- WebSocket ---- */\n  function connectWS() {\n    var host = window.location.hostname;\n    var port = window.location.port || 1880;\n    ws = new WebSocket('ws://' + host + ':' + port + '/ws/chart');\n\n    ws.onopen = function() {\n      var dot  = document.getElementById('liveDot');\n      var text = document.getElementById('liveText');\n      if (dot)  dot.style.background = '#f59e0b';\n      if (text) { text.style.color = '#f59e0b'; text.textContent = 'Connected — waiting for data...'; }\n    };\n\n    ws.onmessage = function(e) {\n      try {\n        var pkt = JSON.parse(e.data);\n        if (pkt.type === 'update') {\n          if (pkt.chart) { pushChart(pkt.chart); updateStatus(pkt.chart); }\n          if (pkt.table) { renderTable(pkt.table); }\n        }\n      } catch(err) {\n        console.error('WS parse error:', err);\n      }\n    };\n\n    ws.onerror = function() {\n      var text = document.getElementById('liveText');\n      if (text) text.textContent = 'WebSocket error';\n    };\n    ws.onclose = function() {\n      var text = document.getElementById('liveText');\n      if (text) text.textContent = 'Reconnecting...';\n      setTimeout(connectWS, 3000);\n    };\n  }\n\n  setTimeout(function() { buildChart(); connectWS(); }, 400);\n})();\n</script>",
