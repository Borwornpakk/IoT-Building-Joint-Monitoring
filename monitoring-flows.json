    {
        "id": "7f776bfcdd08379a",
        "type": "function",
        "z": "bf0b092fe846c588",
        "name": "Prepare Dual-Axis Chart Data & Table Data",
        "func": "const data = msg.payload;\nif (!data || data.temperature === undefined) return null;\n\n// Thresholds จาก TDS จริง\nconst JOINT_W     = data.jointWidthMm   || 10;\nconst DESIGN_MM   = data.designMoveMm   || 5.0;   // ±50% × 10mm\nconst ALARM_MM    = data.alarmMm        || 5.0;   // ASTM C719\nconst WARN_MM     = data.warnMm         || 4.0;   // 80% of design\nconst ULTIMATE_MM = data.ultimateElongMm || 40.0; // 400% ASTM C1135\n\nconst ts  = new Date(data.timestamp || Date.now());\nconst hh  = ts.getHours().toString().padStart(2,'0');\nconst mm2 = ts.getMinutes().toString().padStart(2,'0');\nconst ss  = ts.getSeconds().toString().padStart(2,'0');\n\nconst disp          = data.displacement;\nconst elong         = data.elongation;\nconst designUsedPct = data.designUsedPct ||\n                      parseFloat(((disp / DESIGN_MM) * 100).toFixed(1));\n\n// Alert count — สะสมเฉพาะ ALARM ขึ้นไป\nlet alertCount = context.get('alertCount') || 0;\nif (disp >= ALARM_MM) {\n    alertCount++;\n    context.set('alertCount', alertCount);\n}\n\n// Badge logic ตาม TDS\nlet dispBadge  = 'Within Limit';\nlet elongBadge = 'Safe';\nlet alertBadge = 'No Alarm';\n\nif (disp >= ULTIMATE_MM) {\n    dispBadge  = 'CRITICAL';\n    elongBadge = 'FAILURE RISK';\n    alertBadge = 'CRITICAL';\n} else if (disp >= ALARM_MM) {\n    dispBadge  = 'ALARM';\n    elongBadge = 'Exceeds ±50%';\n    alertBadge = 'ALARM';\n} else if (disp >= WARN_MM) {\n    dispBadge  = 'WARNING';\n    elongBadge = '>80% of limit';\n    alertBadge = alertCount > 0 ? alertCount + ' events' : 'No Alarm';\n}\n\nmsg.payload = JSON.stringify({\n    type: 'update',\n    chart: {\n        label:          hh + ':' + mm2 + ':' + ss,\n        temperature:    data.temperature,\n        displacement:   disp,\n        elongation:     elong,\n        designUsedPct:  designUsedPct,\n        alarmFlag:      disp >= ALARM_MM,\n        warnFlag:       disp >= WARN_MM,\n        criticalFlag:   disp >= ULTIMATE_MM\n    },\n    table: msg.readings || [],\n    metrics: {\n        temperature:    data.temperature,\n        displacement:   disp,\n        elongation:     elong,\n        designUsedPct:  designUsedPct,\n        alertCount:     alertCount,\n        dispBadge:      dispBadge,\n        elongBadge:     elongBadge,\n        alertBadge:     alertBadge,\n        // TDS reference — ส่งไป dashboard ด้วย\n        designMoveMm:   DESIGN_MM,\n        alarmMm:        ALARM_MM,\n        warnMm:         WARN_MM,\n        ultimateMm:     ULTIMATE_MM,\n        jointWidthMm:   JOINT_W\n    }\n});\n\nmsg.topic = 'chartPoint';\nreturn msg;",
